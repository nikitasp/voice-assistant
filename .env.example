# Copy to .env in this directory and fill in the values:
#   cp .env.example .env

# --- LiveKit (default: provided LiveKit Cloud project) ---
# URL the agent connects to.
LIVEKIT_URL=wss://your-project.livekit.cloud
# URL the browser connects to (returned by the backend token endpoint).
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Local LiveKit server instead of Cloud ---
# Start with: docker compose --profile local-livekit up --build
# LIVEKIT_URL=ws://host.docker.internal:7880
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# --- AI providers ---
LLM_API_KEY=
STT_API_KEY=
TTS_API_KEY=

# --- Database ---
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian

# --- Host ports ---
POSTGRES_PORT=5432
BACKEND_PORT=8000
WEB_PORT=3000
