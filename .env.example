# Copy to .env in this directory and fill in the values:
#   cp .env.example .env

# --- LiveKit (default: provided LiveKit Cloud project) ---
# URL the agent connects to.
LIVEKIT_URL=wss://your-project.livekit.cloud
# URL the browser connects to (returned by the backend token endpoint).
LIVEKIT_PUBLIC_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Local LiveKit server instead of Cloud ---
# Start with: docker compose --profile local-livekit up --build
# LIVEKIT_URL=ws://host.docker.internal:7880
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Agent → backend
BACKEND_URL=http://localhost:8000

# --- AI providers ---
# OpenAI by default. For free/dev alternatives, set LLM_BASE_URL + LLM_MODEL:
#   Groq (free tier): https://console.groq.com/keys
#     LLM_API_KEY=<groq key>
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-120b
#   Ollama (local, free): install ollama, then `ollama pull llama3.1`
#     LLM_API_KEY=ollama
#     LLM_BASE_URL=http://host.docker.internal:11434/v1
#     LLM_MODEL=llama3.1
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=gpt-4.1-mini
STT_API_KEY=
TTS_API_KEY=
# Cartesia model for backend voice previews (agent uses sonic-3 by default).
# TTS_MODEL=sonic-3

# --- Database ---
POSTGRES_USER=meridian
POSTGRES_PASSWORD=meridian
POSTGRES_DB=meridian
# Used by the backend container (compose overrides host to `db`).
DATABASE_URL=postgresql+asyncpg://meridian:meridian@localhost:5432/meridian

# --- Backend tuning (optional; passed into the backend container) ---
# FAQ_SEARCH_THRESHOLD=0.42
# UNANSWERED_SIMILARITY_THRESHOLD=0.82
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Web (Vite build / local `npm run dev`) ---
# Leave empty to use same-origin /api via nginx or the Vite proxy.
# VITE_API_BASE_URL=http://localhost:8000

# --- Host ports ---
POSTGRES_PORT=5432
BACKEND_PORT=8000
WEB_PORT=3000
